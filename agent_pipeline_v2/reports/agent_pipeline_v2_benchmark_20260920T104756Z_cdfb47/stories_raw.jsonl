tart": 68, "end": 79}, "S8": {"text": "他端起来喝了一口，", "start": 79, "end": 88}, "S9": {"text": "随后将杯子放回桌面。", "start": 88, "end": 98}, "S10": {"text": "桌角有几粒饼干碎屑，", "start": 98, "end": 108}, "S11": {"text": "他抽出纸巾，", "start": 108, "end": 114}, "S12": {"text": "慢慢擦干净。", "start": 114, "end": 120}, "S13": {"text": "他起身走到窗前，", "start": 121, "end": 129}, "S14": {"text": "把偏到一旁的窗帘拉直。", "start": 129, "end": 140}, "S15": {"text": "帘子的一角碰到手背，", "start": 140, "end": 150}, "S16": {"text": "他随手拨开，", "start": 150, "end": 156}, "S17": {"text": "低头看了看窗台。", "start": 156, "end": 164}, "S18": {"text": "过了一会儿，", "start": 164, "end": 170}, "S19": {"text": "他重新回到椅子边，", "start": 170, "end": 179}, "S20": {"text": "把鞋带打好的结理顺，", "start": 179, "end": 189}, "S21": {"text": "再将两只脚放在椅子下面。", "start": 189, "end": 201}, "S22": {"text": "他从碟子里拿了一块普通饼干，", "start": 201, "end": 215}, "S23": {"text": "吃完后擦了擦嘴，", "start": 215, "end": 223}, "S24": {"text": "又将纸巾折起，", "start": 223, "end": 230}, "S25": {"text": "放在空碟子旁边。", "start": 230, "end": 238}}, "events": [], "ignored_spans": [{"source_id": "S17", "reason": "routine"}, {"source_id": "S18", "reason": "process_detail"}, {"source_id": "S19", "reason": "routine"}, {"source_id": "S20", "reason": "routine"}, {"source_id": "S21", "reason": "routine"}, {"source_id": "S22", "reason": "routine"}, {"source_id": "S23", "reason": "routine"}, {"source_id": "S24", "reason": "routine"}], "non_event_span_ids": [], "uncovered_span_ids": ["S1", "S10", "S11", "S12", "S13", "S14", "S15", "S16", "S2", "S25", "S3", "S4", "S5", "S6", "S7", "S8", "S9"], "rejected": [{"window_id": 1, "target_ids": ["S1", "S2", "S3", "S4", "S5", "S6", "S7", "S8"], "error": "actors须为文字数组"}, {"window_id": 2, "target_ids": ["S9", "S10", "S11", "S12", "S13", "S14", "S15", "S16"], "error": "actors须为文字数组"}, {"window_id": 4, "target_ids": ["S25"], "error": "同一片段出现重复处置"}], "calls": [{"status": "error", "attempts": [{"attempt": 1, "status": "error", "raw_output": "{\"events\":[{\"actors\":[\"雷\"],\"event\":\