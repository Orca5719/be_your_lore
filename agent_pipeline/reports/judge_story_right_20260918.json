      "evidence": [
        {
          "id": "47ba19b8b9ece1f35cc9",
          "text": "亚巴顿寄宿在雷的左侧心脏里，无法在右心脏施展力量。左胸疼痛可能伴随他的苏醒。",
          "file": "angels.md",
          "start_line": 6,
          "end_line": 6,
          "heading_path": [
            "天使设定（测试设定，不代表正式 canon）",
            "亚巴顿",
            "左侧宿主"
          ],
          "start_offset": 43,
          "end_offset": 81,
          "embedding_text": "天使设定（测试设定，不代表正式 canon） > 亚巴顿 > 左侧宿主\n亚巴顿寄宿在雷的左侧心脏里，无法在右心脏施展力量。左胸疼痛可能伴随他的苏醒。",
          "token_count": 66,
          "score": 0.6452745199203491
        },
        {
          "id": "099d1bbdbc348eb3c332",
          "text": "雷拥有两颗心脏。左侧心脏寄宿亚巴顿，右侧心脏寄宿拉古艾尔。",
          "file": "characters.md",
          "start_line": 6,
          "end_line": 6,
          "heading_path": [
            "人物设定（测试设定，不代表正式 canon）",
            "雷",
            "生理结构"
          ],
          "start_offset": 41,
          "end_offset": 70,
          "embedding_text": "人物设定（测试设定，不代表正式 canon） > 雷 > 生理结构\n雷拥有两颗心脏。左侧心脏寄宿亚巴顿，右侧心脏寄宿拉古艾尔。",
          "token_count": 55,
          "score": 0.6115761995315552
        },
        {
          "id": "ca52138556599b584637",
          "text": "2063年大地震摧毁了旧城区。雷在废墟中昏迷，亚巴顿于同一时期提前降临。",
          "file": "history.md",
          "start_line": 6,
          "end_line": 6,
          "heading_path": [
            "历史事件（测试设定，不代表正式 canon）",
            "2063年",
            "大地震"
          ],
          "start_offset": 44,
          "end_offset": 80,
          "embedding_text": "历史事件（测试设定，不代表正式 canon） > 2063年 > 大地震\n2063年大地震摧毁了旧城区。雷在废墟中昏迷，亚巴顿于同一时期提前降临。",
          "token_count": 61,
          "score": 0.5983422994613647
        },
        {
          "id": "252bda4cc47b93db0d7b",
          "text": "拉古艾尔寄宿在雷的右侧心脏里。他的治疗力量会使右胸发热，不会让亚巴顿移动到右侧。",
          "file": "angels.md",
          "start_line": 21,
          "end_line": 21,
          "heading_path": [
            "天使设定（测试设定，不代表正式 canon）",
            "拉古艾尔",
            "右侧宿主"
          ],
          "start_offset": 202,
          "end_offset": 242,
          "embedding_text": "天使设定（测试设定，不代表正式 canon） > 拉古艾尔 > 右侧宿主\n拉古艾尔寄宿在雷的右侧心脏里。他的治疗力量会使右胸发热，不会让亚巴顿移动到右侧。",
          "token_count": 69,
          "score": 0.5500373244285583
        },
        {
          "id": "a739b6548c630e2c4d40",
          "text": "雷曾在大地震期间失去意识。苏醒后，他开始察觉左胸出现异常疼痛。",
          "file": "characters.md",
          "start_line": 11,
          "end_line": 11,
          "heading_path": [
            "人物设定（测试设定，不代表正式 canon）",
            "雷",
            "经历"
          ],
          "start_offset": 85,
          "end_offset": 116,
          "embedding_text": "人物设定（测试设定，不代表正式 canon） > 雷 > 经历\n雷曾在大地震期间失去意识。苏醒后，他开始察觉左胸出现异常疼痛。",
          "token_count": 55,
          "score": 0.5453594923019409
        }
      ],
