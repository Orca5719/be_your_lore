        "evidence": [
          {
            "id": "0ad0e47151069e9d8676",
            "text": "雷在第三话向德尔塔说明双心脏与寄宿天使的秘密，德尔塔从此知道雷的宿主身份。",
            "file": "history.md",
            "start_line": 31,
            "end_line": 31,
            "heading_path": [
              "历史事件（测试设定，不代表正式 canon）",
              "第三话",
              "身份告知"
            ],
            "start_offset": 322,
            "end_offset": 359,
            "embedding_text": "历史事件（测试设定，不代表正式 canon） > 第三话 > 身份告知\n雷在第三话向德尔塔说明双心脏与寄宿天使的秘密，德尔塔从此知道雷的宿主身份。",
            "token_count": 65,
            "score": 0.49175843596458435
          },
          {
            "id": "a739b6548c630e2c4d40",
            "text": "雷曾在大地震期间失去意识。苏醒后，他开始察觉左胸出现异常疼痛。",
            "file": "characters.md",
            "start_line": 11,
            "end_line": 11,
            "heading_path": [
              "人物设定（测试设定，不代表正式 canon）",
              "雷",
              "经历"
            ],
            "start_offset": 85,
            "end_offset": 116,
            "embedding_text": "人物设定（测试设定，不代表正式 canon） > 雷 > 经历\n雷曾在大地震期间失去意识。苏醒后，他开始察觉左胸出现异常疼痛。",
            "token_count": 55,
            "score": 0.48767805099487305
          },
          {
            "id": "46422ea243d878bfdce9",
            "text": "雷隐藏自己是双宿主的身份。除了德尔塔与两位寄宿天使，其他人不知道两颗心脏的秘密。",
            "file": "characters.md",
            "start_line": 21,
            "end_line": 21,
            "heading_path": [
              "人物设定（测试设定，不代表正式 canon）",
              "雷",
              "身份保密"
            ],
            "start_offset": 189,
            "end_offset": 229,
            "embedding_text": "人物设定（测试设定，不代表正式 canon） > 雷 > 身份保密\n雷隐藏自己是双宿主的身份。除了德尔塔与两位寄宿天使，其他人不知道两颗心脏的秘密。",
            "token_count": 66,
            "score": 0.48660585284233093
          },
          {
            "id": "347b69141392efe457ad",
            "text": "雷的父亲不知道拉古艾尔寄宿在雷体内。他误以为儿子的胸痛只是普通心脏疾病。",
            "file": "characters.md",
            "start_line": 51,
            "end_line": 51,
            "heading_path": [
              "人物设定（测试设定，不代表正式 canon）",
              "雷的父亲",
              "秘密认知"
            ],
            "start_offset": 506,
            "end_offset": 542,
            "embedding_text": "人物设定（测试设定，不代表正式 canon） > 雷的父亲 > 秘密认知\n雷的父亲不知道拉古艾尔寄宿在雷体内。他误以为儿子的胸痛只是普通心脏疾病。",
            "token_count": 65,
            "score": 0.47278767824172974
          },
          {
            "id": "099d1bbdbc348eb3c332",
            "text": "雷拥有两颗心脏。左侧心脏寄宿亚巴顿，右侧心脏寄宿拉古艾尔。",
            "file": "characters.md",
            "start_line": 6,
            "end_line": 6,
